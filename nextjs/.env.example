# Copy to .env.local and fill in what you use. Everything is optional: with nothing set, the docs and /print work,
# and /capture saves stills to ../_media/<kind>/ (shown on /live).
# Restart `pnpm dev` after editing; this file is read at startup.

# Descriptions: each capture gets a few sentences from a vision model on OpenRouter (a transcription for documents),
# shown on /capture and /live. Any OpenRouter model that takes images works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Name that goes into each filename and the Slack message. Defaults to the computer's name.
CAPTURE_MACHINE=

# Slack (optional): the channel captures go to (C… ID; channel name → About → bottom of the panel).
SLACK_CHANNEL_ID=
# Upload as a person, with public links and a Markdown embed line in the thread.
# xoxp- user token; user token scopes files:write, files:read, chat:write; workspace allows public file links.
SLACK_USER_TOKEN=
# Or upload as a bot, no public links: xoxb- token with files:write, bot invited to the channel.
# Ignored when SLACK_USER_TOKEN is set.
SLACK_BOT_TOKEN=
